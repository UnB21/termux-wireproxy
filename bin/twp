#!/data/data/com.termux/files/usr/bin/bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

COMMAND="${1:-help}"

case "$COMMAND" in

    start)
        "$PROJECT_DIR/scripts/start.sh"
        ;;

    stop)
        "$PROJECT_DIR/scripts/stop.sh"
        ;;

    restart)
        "$PROJECT_DIR/scripts/restart.sh"
        ;;

    status)
        "$PROJECT_DIR/scripts/status.sh"
        ;;

    health)
        "$PROJECT_DIR/scripts/health.sh"
        ;;

    current)
        "$PROJECT_DIR/scripts/current.sh"
        ;;

    profiles|list)
        "$PROJECT_DIR/scripts/profiles.sh"
        ;;

    profile)
        shift
        "$PROJECT_DIR/scripts/profile.sh" "$@"
        ;;

    providers)
        "$PROJECT_DIR/scripts/providers.sh"
        ;;

    doctor)
        "$PROJECT_DIR/scripts/doctor.sh"
        ;;

    ip)
        "$PROJECT_DIR/scripts/ip.sh"
        ;;

    logs)
        "$PROJECT_DIR/scripts/logs.sh" "$@"
        ;;

    config)
        exec "$PROJECT_DIR/scripts/config.sh"
        ;;

    use)
        shift

        if [ "$#" -ne 2 ]; then
            echo "Usage:"
            echo "  twp use <provider> <profile>"
            echo
            echo "Example:"
            echo "  twp use proton jcwgconfig3-US-FREE-46-ipv4test.conf"
            exit 1
        fi

        "$PROJECT_DIR/scripts/use.sh" "$@"
        ;;

    version)
        echo "Termux WireProxy"
        echo "Version: $(cat "$PROJECT_DIR/VERSION")"
        ;;

    install)
        echo "Installing twp command..."

        TARGET="$PREFIX/bin/twp"

        ln -sf "$SCRIPT_PATH" "$TARGET"

        echo "Installed:"
        echo "$TARGET"
        ;;

    help|*)
        cat <<EOF

Termux WireProxy

Usage:

  twp start
  twp stop
  twp restart
  twp status
  twp health
  twp current
  twp profiles
  twp profile list
  twp profile info <profile>
  twp profile compare <profile1> <profile2>
  twp profile validate
  twp providers
  twp doctor
  twp ip
  twp logs
  twp logs -f
  twp config
  twp use <provider> <profile>
  twp version
  twp install

Aliases:

  twp list        (same as twp profiles)

Examples:

  twp profiles

  twp profile info jcwgconfig3-US-FREE-46.conf

  twp profile compare jcwgconfig2-NL-FREE-102.conf jcwgconfig3-US-FREE-46.conf

  twp use proton jcwgconfig3-US-FREE-46-ipv4test.conf

  twp restart

  twp doctor

EOF
        ;;

esac
